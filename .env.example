# API key required on write endpoints (POST /api/events, PATCH /api/events/:id/close)
# Leave unset for local dev — server will warn and skip enforcement.
API_KEY=

# WZDx feed publisher metadata (emitted in feed_info and data_sources)
WZDX_PUBLISHER=Independent Work Zone Feed (pilot)
WZDX_CONTACT_NAME=Your Name
WZDX_CONTACT_EMAIL=you@example.com

# Server port (default: 3000)
PORT=3000
